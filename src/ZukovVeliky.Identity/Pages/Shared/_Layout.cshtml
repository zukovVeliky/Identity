@* Fallback for an application without its own layout. A file at the same path in the application replaces it. *@
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/_content/ZukovVeliky.Identity/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <main class="container py-4">
        @RenderBody()
    </main>
    <script src="~/_content/ZukovVeliky.Identity/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/ZukovVeliky.Identity/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>